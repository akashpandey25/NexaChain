{
  "name": "nexachain-investment-platform",
  "version": "1.0.0",
  "description": "NexaChain – Investment & Referral Management Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "start:backend": "npm start --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "test": "npm test --prefix backend",
    "test:backend": "npm test --prefix backend",
    "test:e2e": "playwright test",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^9.1.2"
  }
}
