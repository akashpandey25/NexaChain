# ==============================================================================
# NexaChain Frontend - Production & Development Environment Template
# ==============================================================================
# Copy this file to `frontend/.env` for local execution or configure in your static
# hosting provider (Vercel, Netlify, Cloudflare Pages, AWS S3/CloudFront).
# ==============================================================================

# API Base URL pointing to the running backend service (without trailing slash)
# Local development default:
VITE_API_URL=http://localhost:5000/api

# Production example:
# VITE_API_URL=https://api.nexachain.example.com/api
# Reverse proxy / same-domain example:
# VITE_API_URL=/api
