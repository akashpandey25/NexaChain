# ==============================================================================
# NexaChain Backend - Production & Development Environment Template
# ==============================================================================
# Copy this file to `backend/.env` for local execution or inject into your cloud
# hosting environment (Docker, Kubernetes, Render, Railway, AWS ECS, Heroku).
# NOTE: Never commit `.env` containing sensitive credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB Replica Set Required)
# ------------------------------------------------------------------------------
# IMPORTANT: Multi-document financial transactions (ROI accrual, referral
# distributions) require a MongoDB Replica Set or MongoDB Atlas cluster.
# Standalone mongod instances without replica set support will be rejected.
#
# Development (Local Single-Node Replica Set):
# MONGO_URI=mongodb://127.0.0.1:27017/nexachain?replicaSet=rs0
#
# Production (MongoDB Atlas Cluster):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexachain?retryWrites=true&w=majority&appName=NexaChain
MONGO_URI=mongodb://127.0.0.1:27017/nexachain

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Generate a cryptographically secure key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_in_production
JWT_EXPIRES_IN=1d

# ------------------------------------------------------------------------------
# 4. CORS Whitelist
# ------------------------------------------------------------------------------
# Fully qualified URL of the frontend client application (no trailing slash)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Background Scheduler & Distributed Locking (Node-Cron)
# ------------------------------------------------------------------------------
# Master switch to toggle daily cron scheduler in this process (true/false)
CRON_ENABLED=true

# Daily schedule expression (default: 0 0 * * * = midnight daily)
CRON_SCHEDULE=0 0 * * *

# Authoritative business timezone for calendar-day normalization
CRON_TIMEZONE=Asia/Kolkata

# Distributed lock lease duration in milliseconds (default: 10 minutes = 600000)
CRON_LOCK_LEASE_MS=600000

# Distributed lock heartbeat renewal interval in milliseconds (default: 30 seconds = 30000)
CRON_HEARTBEAT_MS=30000

# Graceful shutdown wait period for in-flight financial job completion in ms (default: 8000)
CRON_SHUTDOWN_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# 6. Daily ROI Engine Operational Controls
# ------------------------------------------------------------------------------
# Number of active investments processed per cursor batch (default: 100, max: 500)
ROI_BATCH_SIZE=100

# Rounding mode for fractional paise: FLOOR (default, preserves solvency), ROUND, CEIL
ROI_ROUNDING_MODE=FLOOR

# Immediate wallet crediting upon daily accrual (true/false, default: true)
ROI_CREDIT_WALLET_IMMEDIATELY=true

# ------------------------------------------------------------------------------
# 7. Multi-Level Referral Commission Engine
# ------------------------------------------------------------------------------
# NOTICE: Referral commission engine remains DISABLED by default pending company
# stakeholder approval on business commission rates and triggers.
REFERRAL_COMMISSION_ENABLED=false

# Trigger event: INVESTMENT_ACTIVATION or ROI_PAYOUT
# REFERRAL_COMMISSION_TRIGGER=INVESTMENT_ACTIVATION

# Calculation basis: INVESTMENT_PRINCIPAL or ROI_AMOUNT
# REFERRAL_COMMISSION_BASIS=INVESTMENT_PRINCIPAL

# Maximum generational tiers for commissions (e.g. 3, 5, 10; max safety guard: 20)
# REFERRAL_COMMISSION_MAX_LEVELS=3

# JSON mapping of tier to rate in basis points (100 bps = 1.0%): e.g. {"1":500,"2":300,"3":100}
# REFERRAL_COMMISSION_RATES_BPS={"1":500,"2":300,"3":100}

# Rounding mode for commission paise: FLOOR (default), ROUND, CEIL
# REFERRAL_COMMISSION_ROUNDING=FLOOR

# Credit beneficiary wallet balance immediately upon event (true/false, default: true)
# REFERRAL_COMMISSION_CREDIT_IMMEDIATELY=true

# Require beneficiary account to be active to receive payout (true/false, default: true)
# REFERRAL_REQUIRE_ACTIVE_BENEFICIARY=true
